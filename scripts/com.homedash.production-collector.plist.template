<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.homedash.production-collector</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_ROOT__/.venv/bin/python</string>
        <string>__PROJECT_ROOT__/scripts/collect_snapshot.py</string>
        <string>--snapshot-interval</string>
        <string>30</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/data/logs/collector.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/data/logs/collector.err.log</string>
</dict>
</plist>
