<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.homedash.production-collector</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PRODUCTION_ROOT__/.venv/bin/python</string>
        <string>__PRODUCTION_ROOT__/scripts/collect_snapshot.py</string>
        <string>--snapshot-interval</string>
        <string>30</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PRODUCTION_ROOT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOMEDASH_DATABASE</key>
        <string>__PRODUCTION_DATA__/heating_data.db</string>
        <key>HOMEDASH_CONFIG</key>
        <string>__PRODUCTION_ROOT__/config.ini</string>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__PRODUCTION_DATA__/logs/collector.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PRODUCTION_DATA__/logs/collector.err.log</string>
</dict>
</plist>
