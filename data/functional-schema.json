{
  "schema_version": 1,
  "name": "Wärmepumpenanlage · Funktionssicht",
  "viewport": {
    "width": 1200,
    "height": 700
  },
  "nodes": [
    {
      "id": "outdoor",
      "type": "outdoor",
      "label": "Außeneinheit",
      "x": 60,
      "y": 260,
      "width": 190,
      "height": 120,
      "binding": {
        "feature": "heating.compressors.0",
        "property": "active",
        "unit": ""
      }
    },
    {
      "id": "unit",
      "type": "unit",
      "label": "Inneneinheit",
      "x": 320,
      "y": 240,
      "width": 210,
      "height": 150,
      "binding": {
        "feature": "heating.boiler.pumps.internal",
        "property": "current",
        "unit": ""
      }
    },
    {
      "id": "buffer",
      "type": "tank",
      "label": "Pufferspeicher",
      "x": 640,
      "y": 120,
      "width": 190,
      "height": 230,
      "binding": {
        "feature": "heating.bufferCylinder.sensors.temperature.main",
        "property": "value",
        "unit": "celsius"
      }
    },
    {
      "id": "dhw",
      "type": "dhw",
      "label": "Warmwasserspeicher",
      "x": 640,
      "y": 380,
      "width": 190,
      "height": 180,
      "binding": {
        "feature": "heating.dhw.sensors.temperature.dhwCylinder",
        "property": "value",
        "unit": "celsius"
      }
    },
    {
      "id": "circuit",
      "type": "circuit",
      "label": "Heizkreis",
      "x": 880,
      "y": 160,
      "width": 250,
      "height": 115,
      "binding": {
        "feature": "heating.circuits.0.sensors.temperature.supply",
        "property": "value",
        "unit": "celsius"
      }
    }
  ],
  "edges": [
    {
      "id": "outdoor-unit",
      "source": "outdoor",
      "target": "unit",
      "kind": "hydraulic"
    },
    {
      "id": "unit-buffer",
      "source": "unit",
      "target": "buffer",
      "kind": "hydraulic"
    },
    {
      "id": "buffer-circuit",
      "source": "buffer",
      "target": "circuit",
      "kind": "hydraulic"
    },
    {
      "id": "unit-dhw",
      "source": "unit",
      "target": "dhw",
      "kind": "hydraulic"
    }
  ]
}
