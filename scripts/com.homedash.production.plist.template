<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.homedash.production</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>__PRODUCTION_ROOT__/scripts/run_production.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PRODUCTION_ROOT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOMEDASH_DATABASE</key>
        <string>__PRODUCTION_DATA__/heating_data.db</string>
        <key>HOMEDASH_CONFIG</key>
        <string>__PRODUCTION_ROOT__/config.ini</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__PRODUCTION_DATA__/logs/production.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PRODUCTION_DATA__/logs/production.err.log</string>
</dict>
</plist>
